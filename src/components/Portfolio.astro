---
import { langs, langPath, langLabel, links, skills, showSGA, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t[lang];
const year = new Date().getFullYear();
const sections = ['projects', 'studies', 'experience', 'contact'] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(langPath[l], Astro.site)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="logo" href={langPath[lang]} aria-label="Axel Torres Fernández">AT<span>.</span></a>
        <nav class="nav-links">
          {sections.map((s) => <a href={`#${s}`}>{c.nav[s]}</a>)}
        </nav>
        <div class="lang" role="group" aria-label="Language">
          {
            langs.map((l) => (
              <a href={langPath[l]} hreflang={l} data-lang={l} aria-current={l === lang ? 'true' : undefined}>
                {langLabel[l]}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main>
      <section class="hero wrap" id="top">
        <p class="kicker">{c.hero.kicker}</p>
        <h1>Axel Torres Fernández</h1>
        <p class="hero-title">{c.hero.title}</p>
        <nav class="hero-nav">
          {sections.map((s, i) => (
            <a href={`#${s}`}>
              <span class="num">0{i + 1}</span>
              {c.nav[s]}
            </a>
          ))}
        </nav>
        <a class="scroll-hint" href="#about" aria-label="Scroll">↓</a>
      </section>

      <section id="about" class="wrap section about">
        <p class="lead">{c.hero.lead}</p>
        <div class="socials">
          <a class="social" href={links.github} target="_blank" rel="noopener">
            <i class="icon" style="--src: url(/img/github.svg)"></i>GitHub
          </a>
          {links.linkedin && (
            <a class="social" href={links.linkedin} target="_blank" rel="noopener">
              <i class="icon" style="--src: url(/img/linkedin.svg)"></i>LinkedIn
            </a>
          )}
          {links.cv && (
            <a class="social" href={links.cv} download>
              <i class="icon" style="--src: url(/img/cv.svg)"></i>{c.hero.cv}
            </a>
          )}
        </div>
      </section>

      <section id="projects" class="wrap section">
        <h2><span class="num">01</span>{c.projects.title}</h2>

        <article class="project">
          <div class="project-visual" aria-hidden="true">
            <div class="screen">
              <div class="strip">
                <div class="win w1"><i></i></div>
                <div class="win w2"><i></i></div>
                <div class="win w3"><i></i></div>
                <div class="win w4"><i></i></div>
                <div class="win w5"><i></i></div>
              </div>
            </div>
            <div class="keys"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>←</kbd><kbd>→</kbd></div>
          </div>
          <div class="project-body">
            <div class="meta">
              <span class="tag"><i class="icon" style="--src: url(/img/apple.svg)"></i>macOS</span>
              <span class="tag"><i class="icon" style="--src: url(/img/swift.svg)"></i>Swift</span>
              <span class="status live">{c.projects.dispose.status}</span>
            </div>
            <h3>Dispose</h3>
            <p>{c.projects.dispose.summary}</p>
            <ul class="points">
              {c.projects.dispose.points.map((p) => <li>{p}</li>)}
            </ul>
            <div class="actions">
              <a class="btn primary" href={links.disposeRelease} target="_blank" rel="noopener">{c.projects.dispose.download}</a>
              <a class="btn" href={links.dispose} target="_blank" rel="noopener">{c.projects.dispose.repo} ↗</a>
            </div>
          </div>
        </article>

        {
          showSGA && (
            <article class="project">
              <div class="project-visual" aria-hidden="true">
                <div class="screen racks">
                  {Array.from({ length: 6 }, () => <div class="rack" />)}
                  <div class="picker" />
                </div>
              </div>
              <div class="project-body">
                <div class="meta">
                  <span class="tag">{c.projects.sga.tag}</span>
                  <span class="status wip">{c.projects.sga.status}</span>
                </div>
                <h3>SGA</h3>
                <p>{c.projects.sga.summary}</p>
              </div>
            </article>
          )
        }
      </section>

      <section id="studies" class="wrap section">
        <h2><span class="num">02</span>{c.studies.title}</h2>
        <div class="degree">
          <div class="degree-body">
            <div class="meta">
              <span class="tag">{c.studies.degree.badge}</span>
              <span class="status live">{c.studies.degree.when}</span>
            </div>
            <h3 class="majors">
              <span>{c.studies.degree.majors[0]}</span>
              <span class="plus" aria-hidden="true">+</span>
              <span>{c.studies.degree.majors[1]}</span>
            </h3>
            <p class="detail">{c.studies.degree.detail}</p>
            <p class="where">{c.studies.degree.where}</p>
          </div>
          <img class="uab" src="/img/uab.svg" alt="Universitat Autònoma de Barcelona" />
        </div>
        <div class="card">
          <h4>{c.studies.skillsTitle}</h4>
          <div class="tech">
            {
              skills.map((x) => (
                <div class="tech-item">
                  <i class="icon" style={`--src: url(/img/${x.icon}.svg); color: ${x.color}`} />
                  <span>{x.name}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="card langs">
          <h4>{c.studies.languagesTitle}</h4>
          <div class="lang-list">{c.studies.languages.map((x) => <span>{x}</span>)}</div>
        </div>
      </section>

      <section id="experience" class="wrap section">
        <h2><span class="num">03</span>{c.experience.title}</h2>
        <div class="card job">
          <div class="tl-head">
            <h3>{c.experience.role}</h3>
            <span class="when">{c.experience.when}</span>
          </div>
          <p class="where">{c.experience.company}</p>
          <ul class="points">{c.experience.points.map((p) => <li>{p}</li>)}</ul>
          <p class="note">{c.experience.note}</p>
        </div>
      </section>

      <section id="contact" class="wrap section contact">
        <h2><span class="num">04</span>{c.contact.title}</h2>
        <p class="lead">{c.contact.lead}</p>
        <div class="actions">
          <a class="btn primary" href={`mailto:${links.email}`}>{c.contact.email}</a>
          {links.linkedin && <a class="btn" href={links.linkedin} target="_blank" rel="noopener">{c.contact.linkedin} ↗</a>}
          <a class="btn" href={links.github} target="_blank" rel="noopener">{c.contact.github} ↗</a>
          {links.cv && <a class="btn" href={links.cv} download>{c.hero.cv} ↓</a>}
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <span>© {year} Axel Torres Fernández</span>
      <span>{c.footer}</span>
    </footer>

    <script is:inline>
      // The top-bar links only appear once the hero buttons scroll away.
      const nav = document.querySelector('.nav');
      new IntersectionObserver(([e]) => nav.classList.toggle('scrolled', !e.isIntersecting)).observe(
        document.querySelector('.hero-nav')
      );

      // Remember the chosen language for next visits.
      document.querySelectorAll('.lang a').forEach((a) =>
        a.addEventListener('click', () => {
          try { localStorage.setItem('lang', a.dataset.lang); } catch {}
        })
      );
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #02040a;
    --surface: #060b15;
    --surface-2: #0a1120;
    --border: #141f35;
    --text: #e4ecf8;
    --muted: #8496b3;
    --blue: #3b82f6;
    --blue-soft: #60a5fa;
    --blue-dim: rgba(59, 130, 246, 0.14);
    --radius: 14px;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --display: 'Space Grotesk', system-ui, sans-serif;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body {
    margin: 0;
    background:
      linear-gradient(rgba(96, 165, 250, 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(96, 165, 250, 0.035) 1px, transparent 1px) 0 0 / 48px 48px,
      var(--bg);
    color: var(--text);
    font: 16px/1.65 Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, h4 { font-family: var(--display); line-height: 1.15; margin: 0; }
  .wrap { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 20px; }

  .glow {
    position: fixed;
    inset: -30vh -20vw auto auto;
    width: 70vw;
    height: 70vh;
    background: radial-gradient(closest-side, rgba(59, 130, 246, 0.14), transparent);
    filter: blur(40px);
    pointer-events: none;
    z-index: -1;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: rgba(2, 4, 10, 0.75);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { display: flex; align-items: center; gap: 24px; height: 64px; }
  .logo { font-family: var(--display); font-weight: 700; font-size: 20px; }
  .logo span { color: var(--blue); }
  .nav-links {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 14px;
    color: var(--muted);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.3s, transform 0.3s, visibility 0.3s;
  }
  .nav.scrolled .nav-links { opacity: 1; visibility: visible; transform: none; }
  .nav-links a:hover { color: var(--text); }
  .lang { display: flex; border: 1px solid var(--border); border-radius: 999px; padding: 3px; }
  .lang a {
    font: 500 12px var(--mono);
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--muted);
  }
  .lang a:hover { color: var(--text); }
  .lang a[aria-current] { background: var(--blue); color: #fff; }

  /* Hero */
  .hero {
    position: relative;
    min-height: calc(100svh - 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 40px;
    padding-bottom: 80px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 15% 10%;
    background: radial-gradient(closest-side, rgba(59, 130, 246, 0.16), transparent);
    filter: blur(30px);
    z-index: -1;
  }
  .kicker { font: 500 13px/1.6 var(--mono); color: var(--blue-soft); letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 16px; max-width: 640px; text-wrap: balance; }
  .hero h1 {
    font-size: clamp(42px, 9vw, 96px);
    letter-spacing: -0.035em;
    background: linear-gradient(180deg, #fff 30%, #9dbcf0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 48px;
    width: 100%;
    max-width: 720px;
  }
  .hero-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 16px 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(6, 11, 21, 0.7);
    font-family: var(--display);
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .hero-nav a:hover { border-color: var(--blue); background: var(--blue-dim); transform: translateY(-2px); }
  .hero-nav .num { font-size: 12px; }
  .scroll-hint {
    position: absolute;
    bottom: 24px;
    color: var(--muted);
    font-size: 20px;
    animation: bob 2.4s ease-in-out infinite;
  }
  .scroll-hint:hover { color: var(--blue-soft); }
  @keyframes bob { 50% { transform: translateY(6px); } }
  .about { padding-top: 72px; }
  .about { text-align: center; }
  .about .lead { font-size: 20px; max-width: 720px; margin: 0 auto; color: var(--text); text-wrap: balance; }
  .hero-title {
    font-family: var(--display);
    font-size: clamp(20px, 3vw, 30px);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 14px 0 0;
    background: linear-gradient(90deg, var(--blue-soft), #a5c8ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead { color: var(--muted); font-size: 18px; max-width: 620px; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 20px;
    border-radius: 10px;
    border: 1px solid var(--border);
    font-weight: 500;
    font-size: 15px;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .btn:hover { border-color: var(--blue); transform: translateY(-1px); }
  .btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; }
  .btn.primary:hover { background: #2f6fe0; }
  .socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 36px; }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 180px;
    justify-content: center;
    padding: 16px 26px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-family: var(--display);
    font-size: 17px;
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .social:hover { border-color: var(--blue); background: var(--blue-dim); transform: translateY(-2px); }
  .social .icon { width: 22px; height: 22px; margin: 0; color: var(--blue-soft); }
  .icon {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 6px;
    vertical-align: -1px;
    background: currentColor;
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
  }

  /* Sections */
  .section { padding-top: 56px; padding-bottom: 56px; }
  .section h2 { font-size: 30px; margin-bottom: 32px; display: flex; align-items: baseline; gap: 14px; }
  .num { font: 500 14px var(--mono); color: var(--blue); }

  /* Project */
  .project {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    padding: 32px;
    /* Hairline gradient border: blue at the top fading into the card. */
    background:
      linear-gradient(180deg, var(--surface-2), var(--surface)) padding-box,
      linear-gradient(180deg, rgba(96, 165, 250, 0.45), var(--border) 40%) border-box;
    border: 1px solid transparent;
    border-radius: 20px;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.9);
  }
  .project + .project { margin-top: 24px; }
  .project h3 { font-size: 32px; margin: 12px 0 10px; }
  .project p { color: var(--muted); margin: 0; }
  .meta { display: flex; gap: 10px; flex-wrap: wrap; }
  .tag, .status { font: 500 12px var(--mono); padding: 4px 10px; border-radius: 999px; }
  .tag { background: var(--blue-dim); color: var(--blue-soft); }
  .status { border: 1px solid var(--border); color: var(--muted); }
  .status::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  .status.live::before { background: #34d399; box-shadow: 0 0 8px #34d399; }
  .status.wip::before { background: #fbbf24; }
  .points { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .points li { position: relative; padding-left: 20px; color: var(--muted); font-size: 15px; }
  .points li::before { content: '›'; position: absolute; left: 4px; color: var(--blue); font-weight: 600; }

  /* Dispose animation: a strip of windows gliding under a fixed screen */
  .project-visual { display: flex; flex-direction: column; justify-content: center; gap: 16px; min-width: 0; }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: #050912;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(59, 130, 246, 0.45);
  }
  .strip {
    position: absolute;
    inset: 10% auto 10% 0;
    display: flex;
    gap: 3%;
    padding-left: 5%;
    width: 220%;
    animation: glide 12s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .win {
    flex: none;
    border-radius: 8px;
    border: 1px solid #22385e;
    background: linear-gradient(180deg, #13223d, #0c1729);
    padding: 6px;
  }
  .win i { display: block; height: 6px; width: 30%; border-radius: 3px; background: #22385e; }
  .w1 { width: 14%; }
  .w2 { width: 21%; }
  .w3 { width: 14%; border-color: var(--blue); box-shadow: 0 0 0 1px var(--blue), 0 0 24px rgba(59, 130, 246, 0.35); }
  .w3 i { background: var(--blue); }
  .w4 { width: 21%; }
  .w5 { width: 14%; }
  @keyframes glide {
    0%, 18% { transform: translateX(0); }
    28%, 46% { transform: translateX(-17%); }
    56%, 74% { transform: translateX(-32%); }
    84%, 100% { transform: translateX(0); }
  }
  .keys { display: flex; gap: 6px; justify-content: center; }
  kbd {
    font: 500 13px var(--mono);
    min-width: 30px;
    padding: 5px 8px;
    text-align: center;
    border-radius: 7px;
    border: 1px solid var(--border);
    border-bottom-width: 3px;
    background: var(--surface);
    color: var(--muted);
  }

  /* SGA visual: aisles of racks and a picker walking a route */
  .racks { display: flex; justify-content: space-around; align-items: stretch; padding: 10% 6%; }
  .rack { width: 9%; border-radius: 4px; background: repeating-linear-gradient(180deg, #13223d 0 14%, #050912 14% 18%); border: 1px solid #22385e; }
  .picker {
    position: absolute;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--blue); box-shadow: 0 0 14px var(--blue);
    left: 14%; bottom: 5%;
    animation: pick 9s ease-in-out infinite;
  }
  @keyframes pick {
    0% { left: 14%; bottom: 5%; }
    20% { left: 14%; bottom: 70%; }
    35% { left: 46%; bottom: 70%; }
    55% { left: 46%; bottom: 20%; }
    75% { left: 80%; bottom: 20%; }
    100% { left: 14%; bottom: 5%; }
  }

  /* Studies */
  .degree {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 40px;
    margin-bottom: 16px;
    border-radius: 20px;
    background:
      linear-gradient(180deg, var(--surface-2), var(--surface)) padding-box,
      linear-gradient(180deg, rgba(96, 165, 250, 0.45), var(--border) 40%) border-box;
    border: 1px solid transparent;
  }
  .majors {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 20px 0 16px;
    font-size: clamp(28px, 4.4vw, 46px);
    letter-spacing: -0.025em;
  }
  .majors .plus { font-size: 0.8em; color: var(--blue); line-height: 1.1; }
  .degree .tag { font-size: 14px; padding: 6px 14px; text-transform: uppercase; letter-spacing: 0.08em; }
  .tl-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .tl-head h3 { font-size: 20px; }
  .when { font: 500 13px var(--mono); color: var(--blue-soft); white-space: nowrap; }
  .detail { margin: 6px 0 0; color: var(--text); }
  /* Official logo is green; shown as a quiet white mark to keep the palette. */
  .uab { flex: none; width: 200px; filter: brightness(0) invert(1); opacity: 0.85; }
  .where { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  .tech { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  .tech-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-family: var(--display);
    font-weight: 500;
    transition: border-color 0.2s, transform 0.2s;
  }
  .tech-item:hover { border-color: #2a4170; transform: translateY(-2px); }
  .tech-item .icon { width: 24px; height: 24px; margin: 0; flex: none; }
  .langs { margin-top: 16px; }
  .lang-list { display: flex; flex-wrap: wrap; gap: 8px 32px; color: var(--muted); }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
  .card h4 { font-size: 13px; font-family: var(--mono); font-weight: 500; color: var(--blue-soft); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px; }
  .card ul { margin: 0; padding-left: 18px; color: var(--muted); }

  /* Experience */
  .job { padding: 28px; }
  .note { margin: 20px 0 0; padding-top: 16px; border-top: 1px solid var(--border); color: var(--text); font-style: italic; }

  /* Contact & footer */
  .contact { padding-bottom: 96px; }
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
